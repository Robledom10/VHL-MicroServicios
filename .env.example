# Variables de Ambiente - Ejemplo
# Copiar a .env y rellenar valores reales

# ===== BASE DE DATOS =====
DB_HOST=jdbc:mysql://localhost:3306/reservation_db
DB_USER=root
DB_PASSWORD=password

# Docker
SPRING_DATASOURCE_URL=jdbc:mysql://reservation-db:3306/reservation_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=password

# ===== REDIS =====
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
REDIS_PASSWORD=

# ===== SERVICIOS EXTERNOS =====
SERVICE_PACKAGE_URL=http://localhost:8081
SERVICE_AUTH_URL=http://localhost:8080

# Docker
PACKAGE_SERVICE_URL=http://package-service:8083
AUTH_SERVICE_URL=http://auth-service:8081

# ===== SERVER =====
SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=dev

# ===== ACTUATOR =====
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# ===== CONFIGURACIÓN DE RESERVA =====
RESERVATION_MAX_SPOTS_PER_RESERVATION=10
RESERVATION_CACHE_ENABLED=true
RESERVATION_CACHE_TTL=3600

# ===== LOGGING =====
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_VHL_RESERVATIONSERVICE=DEBUG
