# ============================================================
# COPIA ESTE ARCHIVO A .env Y COMPLETA LOS VALORES REALES
# cp .env.example .env
# ============================================================

# --- PUERTOS DE LOS MICROSERVICIOS ---
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
RESERVATION_SERVICE_PORT=8082
TOURIST_CATALOG_SERVICE_PORT=8083
GALLERY_SERVICE_PORT=8084
FINANCIAL_SERVICE_PORT=8085
OPERATION_SERVICE_PORT=8086
DOCUMENT_SERVICE_PORT=8087
CHATBOT_SERVICE_PORT=8090

# --- CONFIGURACION DE SEGURIDAD (JWT) ---
JWT_SECRET=your_jwt_secret_base64_here
JWT_EXPIRATION=900000

# --- CONFIGURACION BASES DE DATOS MYSQL ---
MYSQL_ROOT_PASSWORD=root

AUTH_DB_NAME=auth_db
AUTH_DB_PORT=3307

FINANCIAL_DB_NAME=pago_db
FINANCIAL_DB_PORT=3308

OPERATION_DB_NAME=trip_operations_db
OPERATION_DB_PORT=3309

RESERVATION_DB_NAME=reservation_db
RESERVATION_DB_PORT=3310

CATALOG_DB_NAME=catalogo_turistico_db
CATALOG_DB_PORT=3311

DOCUMENT_DB_NAME=gestion_documental_db
DOCUMENT_DB_PORT=3312

# --- CONFIGURACION BASE DE DATOS MONGODB ---
GALLERY_MONGO_USERNAME=root
GALLERY_MONGO_PASSWORD=root
GALLERY_MONGO_DB_PORT=27017

# --- CHATBOT / OLLAMA ---
# Ollama corre dentro de Docker (CPU, no necesita GPU)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:1.7b
CATALOG_SERVICE_URL=http://tourist-catalog-service:8083/api/paquetes

# --- CREDENCIALES DE CLOUDINARY ---
# Conseguilas en: cloudinary.com > Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- CREDENCIALES WOMPI ---
# Conseguilas en: dashboard.wompi.co > Desarrolladores > Llaves
WOMPI_PUBLIC_KEY=pub_test_your_wompi_public_key
WOMPI_PRIVATE_KEY=prv_test_your_wompi_private_key

# --- GOOGLE OAUTH ---
# Client ID del proyecto en Google Cloud Console
GOOGLE_ID_CLIENT=your_google_client_id.apps.googleusercontent.com
# Client Secret del proyecto en Google Cloud Console
GOOGLE_SECRET_CLIENT=your_google_client_secret
