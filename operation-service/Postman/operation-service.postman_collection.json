{
  "info": {
    "nombre": "Operation Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083"
    }
  ],
  "item": [
    {
      "nombre": "Crear paquete",
      "solicitud": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/paquetes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Eje Cafetero Familiar\",\n  \"categoria\": \"Familiar\",\n  \"destino\": \"Quindio\",\n  \"descripcion\": \"Paquete turistico de tres dias\",\n  \"precioBase\": 1250000,\n  \"cupoTotal\": 20,\n  \"itinerario\": [{\n    \"numeroDia\": 1,\n    \"titulo\": \"Llegada y city tour\",\n    \"descripcion\": \"Recepcion y recorrido guiado\",\n    \"horaInicio\": \"09:00:00\",\n    \"horaFin\": \"17:00:00\"\n  }]\n}"
        }
      }
    },
    {
      "nombre": "Consultar paquetes con filtros",
      "solicitud": {
        "method": "GET",
        "url": "{{baseUrl}}/paquetes?categoria=Familiar&sortBy=precioBase&direction=asc"
      }
    },
    {
      "nombre": "Actualizar cupos",
      "solicitud": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/paquetes/1/cupos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cupoTotal\": 25,\n  \"motivo\": \"Aumento de disponibilidad\"\n}"
        }
      }
    },
    {
      "nombre": "Crear plan de precio",
      "solicitud": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/planes-precio",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idPaquete\": 1,\n  \"nombre\": \"Pago en cuotas\",\n  \"precio\": 1300000,\n  \"cuotas\": 4,\n  \"condiciones\": \"Cuotas mensuales sin interes\"\n}"
        }
      }
    },
    {
      "nombre": "Crear proveedor",
      "solicitud": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/proveedores",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Transportes Andinos\",\n  \"tipoProveedor\": \"Transporte\",\n  \"nombreContacto\": \"Laura Perez\",\n  \"correo\": \"laura@transportesandinos.com\",\n  \"telefono\": \"3001234567\"\n}"
        }
      }
    },
    {
      "nombre": "Crear seguro",
      "solicitud": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/seguros",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idPaquete\": 1,\n  \"nombre\": \"Seguro viajero basico\",\n  \"detalleCobertura\": \"Asistencia medica y perdida de equipaje\",\n  \"montoCobertura\": 5000000\n}"
        }
      }
    },
    {
      "nombre": "Actualizar configuracion",
      "solicitud": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/configuracion",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreOrganizacion\": \"VHL Travel\",\n  \"correo\": \"operaciones@vhltravel.com\",\n  \"telefono\": \"6011234567\",\n  \"direccion\": \"Bogota, Colombia\",\n  \"logoBase64\": null\n}"
        }
      }
    }
  ]
}
