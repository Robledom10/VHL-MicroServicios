# --- Etapa 1: Build ---
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app

# Copiamos todo el proyecto (incluyendo el pom.xml padre y los módulos)
COPY . .

# Compilamos solo el módulo api-gateway (y sus dependencias necesarias)
RUN mvn clean package -DskipTests

# --- Etapa 2: Run ---
FROM eclipse-temurin:21-jdk-jammy
WORKDIR /app

# Aquí está la clave: copiamos el JAR desde la etapa de 'build'
# Apuntando a la ruta exacta donde Maven dejó el archivo compilado
COPY --from=build /app/target/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]