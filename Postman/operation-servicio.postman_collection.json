{
  "info": {
    "name": "Operation Servicio - HU 2.1 a HU 2.11",
    "description": "Pruebas organizadas para operation-service: paquetes, cupos, planes de precio, proveedores, seguros y configuracion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8083" },
    { "key": "idPaquete", "value": "1" },
    { "key": "idPlanPrecio", "value": "1" },
    { "key": "idProveedor", "value": "1" },
    { "key": "idSeguro", "value": "1" },
    { "key": "correoProveedor", "value": "laura@transportesandinos.com" }
  ],
  "item": [
    {
      "name": "01 - Paquetes turisticos",
      "item": [
        {
          "name": "POST - Crear paquete",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('idPaquete', json.id);",
                  "pm.test('Guarda idPaquete', function () { pm.expect(json.id).to.exist; });",
                  "pm.test('Cupo disponible inicia igual al cupo total', function () { pm.expect(json.cupoDisponible).to.eql(json.cupoTotal); });",
                  "pm.test('Incluye itinerario', function () { pm.expect(json.itinerario.length).to.be.above(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/paquetes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Eje Cafetero Familiar {{$timestamp}}\",\n  \"categoria\": \"Familiar\",\n  \"destino\": \"Quindio\",\n  \"descripcion\": \"Paquete turistico de tres dias\",\n  \"precioBase\": 1250000,\n  \"cupoTotal\": 20,\n  \"itinerario\": [\n    {\n      \"numeroDia\": 1,\n      \"titulo\": \"Llegada y recorrido\",\n      \"descripcion\": \"Recepcion y recorrido guiado\",\n      \"horaInicio\": \"09:00:00\",\n      \"horaFin\": \"17:00:00\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "POST - Validar paquete invalido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Reporta campos invalidos', function () { pm.expect(pm.response.json().campos).to.have.property('nombre'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/paquetes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"categoria\": \"Familiar\",\n  \"destino\": \"Quindio\",\n  \"descripcion\": \"Paquete invalido\",\n  \"precioBase\": 0,\n  \"cupoTotal\": 0\n}"
            }
          }
        },
        {
          "name": "GET - Consultar paquetes con filtros",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Respuesta paginada', function () { pm.expect(pm.response.json()).to.have.property('content'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/paquetes?categoria=Familiar&destino=Quindio&busqueda=Eje&precioMinimo=1000000&precioMaximo=2000000&ordenarPor=precioBase&direccion=asc&pagina=0&tamano=10"
          }
        },
        {
          "name": "GET - Consultar paquete por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Id correcto', function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('idPaquete'))); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/paquetes/{{idPaquete}}"
          }
        },
        {
          "name": "PUT - Actualizar paquete",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Actualiza nombre', function () { pm.expect(pm.response.json().nombre).to.include('Actualizado'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/paquetes/{{idPaquete}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Eje Cafetero Actualizado\",\n  \"categoria\": \"Familiar\",\n  \"destino\": \"Quindio\",\n  \"descripcion\": \"Paquete turistico actualizado\",\n  \"precioBase\": 1350000,\n  \"cupoTotal\": 20,\n  \"itinerario\": [\n    {\n      \"numeroDia\": 1,\n      \"titulo\": \"Llegada\",\n      \"descripcion\": \"Recepcion en hotel\",\n      \"horaInicio\": \"10:00:00\",\n      \"horaFin\": \"12:00:00\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "PUT - Actualizar paquete inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/paquetes/999999",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"No existe\",\n  \"categoria\": \"Familiar\",\n  \"destino\": \"Quindio\",\n  \"descripcion\": \"Paquete inexistente\",\n  \"precioBase\": 1350000,\n  \"cupoTotal\": 20\n}"
            }
          }
        },
        {
          "name": "PUT - Validar itinerario invalido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/paquetes/{{idPaquete}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Itinerario invalido\",\n  \"categoria\": \"Familiar\",\n  \"destino\": \"Quindio\",\n  \"descripcion\": \"Validacion de horas\",\n  \"precioBase\": 1250000,\n  \"cupoTotal\": 20,\n  \"itinerario\": [\n    {\n      \"numeroDia\": 1,\n      \"titulo\": \"Actividad\",\n      \"descripcion\": \"Horas invalidas\",\n      \"horaInicio\": \"18:00:00\",\n      \"horaFin\": \"08:00:00\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "DELETE - Eliminar paquete",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/paquetes/{{idPaquete}}"
          }
        },
        {
          "name": "GET - Consultar paquete eliminado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/paquetes/{{idPaquete}}"
          }
        }
      ]
    },
    {
      "name": "02 - Cupos",
      "item": [
        {
          "name": "PUT - Actualizar cupos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Cupo total actualizado', function () { pm.expect(pm.response.json().cupoTotal).to.eql(25); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/paquetes/{{idPaquete}}/cupos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cupoTotal\": 25,\n  \"motivo\": \"Aumento de disponibilidad\"\n}"
            }
          }
        },
        {
          "name": "GET - Consultar historial de cupos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Historial no vacio', function () { pm.expect(pm.response.json().length).to.be.above(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/paquetes/{{idPaquete}}/cupos/historial"
          }
        }
      ]
    },
