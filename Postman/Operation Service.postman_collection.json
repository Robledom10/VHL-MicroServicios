        },
        {
          "name": "Listar contactos del viaje",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });", "const json = pm.response.json();", "pm.test('lista con contacto registrado', function () {", "  pm.expect(json).to.be.an('array').and.have.length.above(0);", "  pm.expect(json.some(c => c.id === Number(pm.collectionVariables.get('idContacto')))).to.eql(true);", "});"] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/operaciones/viajes/{{idViaje}}/contactos-emergencia" }
        },
        {
          "name": "Actualizar contacto de emergencia",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', function () { pm.response.to.have.status(200); });", "const json = pm.response.json();", "pm.test('contacto actualizado', function () {", "  pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('idContacto')));", "  pm.expect(json.nombre).to.eql('Maria Lopez');", "  pm.expect(json.parentesco).to.eql('Hermana');", "  pm.expect(json.nombreViajero).to.eql('Juan Perez QA');", "});"] } }],
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"idViaje\": {{idViaje}},\n  \"nombre\": \"Maria Lopez\",\n  \"parentesco\": \"Hermana\",\n  \"telefono\": \"3109876543\",\n  \"correo\": \"maria.actualizada@test.com\",\n  \"nombreViajero\": \"Juan Perez QA\"\n}" }, "url": "{{baseUrl}}/api/v1/operaciones/viajeros/{{idViajero}}/contactos-emergencia/{{idContacto}}" }
        },
        {
          "name": "Validar correo invalido",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 400', function () { pm.response.to.have.status(400); });"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"idViaje\": {{idViaje}},\n  \"nombre\": \"Ana Gomez\",\n  \"parentesco\": \"Madre\",\n  \"telefono\": \"3001112233\",\n  \"correo\": \"correo-invalido\",\n  \"nombreViajero\": \"Test Invalido\"\n}" }, "url": "{{baseUrl}}/api/v1/operaciones/viajeros/{{idViajeroSecundario}}/contactos-emergencia" }
        }
      ]
    },
    {
      "name": "07 HU7.2 Check-in QR",
      "item": [
