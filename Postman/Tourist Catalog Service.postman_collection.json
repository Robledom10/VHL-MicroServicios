                                    "const json = pm.response.json();",
                                    "pm.expect(json.id).to.eql(Number(pm.collectionVariables.get(\u0027proveedorId\u0027)));",
                                    "pm.expect(json.tipoProveedor).to.eql(\u0027ALOJAMIENTO\u0027);",
                                    "pm.expect(json.activo).to.eql(true);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Eliminar proveedor",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": "{{baseUrl}}/api/proveedores/{{proveedorId}}"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\u0027status 204\u0027, function () { pm.response.to.have.status(204); });"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Validacion paquete invalido",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"titulo\": \"\",\n  \"destino\": \"\",\n  \"duracionDias\": 0,\n  \"precio\": 0,\n  \"cupo\": 0,\n  \"fechaInicio\": \"2026-07-10\"\n}"
                        },
                        "url": "{{baseUrl}}/api/paquetes"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\u0027status 400\u0027, function () { pm.response.to.have.status(400); });",
                                    "pm.expect(pm.response.json().campos).to.be.an(\u0027object\u0027);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Validacion itinerario con dia repetido",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"titulo\": \"Paquete con itinerario repetido {{$timestamp}}\",\n  \"descripcion\": \"Debe fallar por numeroDia duplicado\",\n  \"destino\": \"Quindio\",\n  \"duracionDias\": 3,\n  \"precio\": 900000.00,\n  \"cupo\": 10,\n  \"fechaInicio\": \"2026-07-10\",\n  \"itinerario\": [\n    {\n      \"numeroDia\": 1,\n      \"titulo\": \"Llegada\"\n    },\n    {\n      \"numeroDia\": 1,\n      \"titulo\": \"Tour repetido\"\n    }\n  ]\n}"
                        },
                        "url": "{{baseUrl}}/api/paquetes"
                    },
                    "event": [
                        {
                            "listen": "test",
