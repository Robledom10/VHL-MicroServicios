                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Validacion itinerario supera duracion",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"titulo\": \"Paquete con itinerario fuera de rango {{$timestamp}}\",\n  \"descripcion\": \"Debe fallar porque el dia 4 supera duracionDias 3\",\n  \"destino\": \"Quindio\",\n  \"duracionDias\": 3,\n  \"precio\": 900000.00,\n  \"cupo\": 10,\n  \"fechaInicio\": \"2026-07-10\",\n  \"itinerario\": [\n    {\n      \"numeroDia\": 4,\n      \"titulo\": \"Dia inexistente\"\n    }\n  ]\n}"
                        },
                        "url": "{{baseUrl}}/api/paquetes"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\u0027status 409\u0027, function () { pm.response.to.have.status(409); });",
                                    "pm.expect(pm.response.json().mensaje).to.include(\u0027duracion del paquete\u0027);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Validacion transporte invalido",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"titulo\": \"Paquete con transporte invalido {{$timestamp}}\",\n  \"descripcion\": \"Debe fallar por transporte no permitido\",\n  \"destino\": \"Quindio\",\n  \"duracionDias\": 3,\n  \"precio\": 900000.00,\n  \"cupo\": 10,\n  \"fechaInicio\": \"2026-07-10\",\n  \"tipoTransporte\": \"Barco\",\n  \"itinerario\": [\n    {\n      \"numeroDia\": 1,\n      \"titulo\": \"Llegada\"\n    }\n  ]\n}"
                        },
                        "url": "{{baseUrl}}/api/paquetes"
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\u0027status 409\u0027, function () { pm.response.to.have.status(409); });",
