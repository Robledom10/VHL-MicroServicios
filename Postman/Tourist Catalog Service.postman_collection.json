            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/categorias/{{categoriaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 204', function () { pm.response.to.have.status(204); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Gateway 8080 con Bearer token",
      "description": "Estas pruebas usan las mismas rutas por gateway. Debes poner un JWT valido en la variable token.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Listar categorias por gateway",
          "request": {
            "method": "GET",
            "header": [],
