{
  "info": {
    "name": "Tourist Catalog Service",
    "description": "Pruebas HTTP end-to-end para tourist-catalog-service pasando por API Gateway. Ejecuta primero Auth / Registrar usuario QA y Auth / Login para guardar el Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "categoriaId",
      "value": ""
    },
    {
      "key": "paqueteId",
      "value": ""
    },
    {
      "key": "proveedorId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "authEmail",
      "value": "catalog.qa.postman@test.com"
    },
    {
      "key": "authPassword",
      "value": "Password123"
    },
    {
      "key": "documentNumber",
      "value": "999000111"
    }
  ],
  "item": [
    {
      "name": "Auth por Gateway",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Registrar usuario QA",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201 o usuario ya existe', function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Catalog\",\n  \"lastName\": \"QA\",\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\",\n  \"documentType\": \"Cedula Ciudadania\",\n  \"documentNumber\": \"{{documentNumber}}\",\n  \"phone\": \"3001234567\",\n  \"birthDate\": \"1995-01-01\",\n  \"state\": \"Quindio\",\n  \"city\": \"Armenia\",\n  \"address\": \"Centro\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login y guardar token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.accessToken).to.exist;",
                  "pm.collectionVariables.set('token', json.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Catalogo por Gateway 8080",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('UP', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Crear categoria",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Aventura {{$timestamp}}\",\n  \"descripcion\": \"Categoria para pruebas HTTP\"\n}"
            },
            "url": "{{baseUrl}}/categorias"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.id).to.exist;",
                  "pm.collectionVariables.set('categoriaId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Listar categorias",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/categorias"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.json()).to.be.an('array');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Actualizar categoria",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Aventura Familiar {{$timestamp}}\",\n  \"descripcion\": \"Categoria actualizada desde Postman\"\n}"
            },
            "url": "{{baseUrl}}/categorias/{{categoriaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('categoriaId')));",
                  "pm.expect(json.nombre).to.include('Aventura Familiar');",
                  "pm.expect(json.activo).to.eql(true);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Crear paquete",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Eje Cafetero {{$timestamp}}\",\n  \"descripcion\": \"Paquete creado desde Postman con el flujo completo del mockup\",\n  \"destino\": \"Quindio\",\n  \"duracionDias\": 3,\n  \"precio\": 1250000.00,\n  \"cupo\": 20,\n  \"fechaInicio\": \"2026-07-10\",\n  \"fechaFin\": \"2026-07-13\",\n  \"lugarSalida\": \"Terminal de Transportes de Medellin\",\n  \"horaSalida\": \"06:30:00\",\n  \"alojamiento\": \"Hotel 3 estrellas o similar\",\n  \"tipoHabitacion\": \"Habitacion multiple (compartida)\",\n  \"tipoTransporte\": \"Bus de turismo\",\n  \"fotoVerticalUrl\": \"https://cdn.vhl.test/paquetes/eje-cafetero-vertical.jpg\",\n  \"fotoHorizontalUrl\": \"https://cdn.vhl.test/paquetes/eje-cafetero-horizontal.jpg\",\n  \"incluye\": [\n    \"Transporte terrestre ida y regreso\",\n    \"Hospedaje en hotel 3 estrellas\",\n    \"Alimentacion (desayuno y cena)\",\n    \"Tours turisticos guiados\",\n    \"Seguro de viaje\"\n  ],\n  \"noIncluye\": [\n    \"Gastos personales\",\n    \"Bebidas alcoholicas\",\n    \"Souvenirs o compras personales\"\n  ],\n  \"politicasCancelacion\": [\n    \"Cancelacion gratuita hasta 5 dias antes del viaje\",\n    \"50% de reembolso hasta 48 horas antes\",\n    \"No hay devolucion el mismo dia del viaje\"\n  ],\n  \"idCategoria\": {{categoriaId}},\n  \"itinerario\": [\n    {\n      \"numeroDia\": 1,\n      \"titulo\": \"Llegada\"\n    },\n    {\n      \"numeroDia\": 2,\n      \"titulo\": \"Tour cafetero\"\n    },\n    {\n      \"numeroDia\": 3,\n      \"titulo\": \"Regreso\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/paquetes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.id).to.exist;",
                  "pm.collectionVariables.set('paqueteId', json.id);",
                  "pm.expect(json.titulo).to.include('Eje Cafetero');",
                  "pm.expect(json.destino).to.eql('Quindio');",
                  "pm.expect(json.duracionDias).to.eql(3);",
                  "pm.expect(json.tipoTransporte).to.eql('Bus de turismo');",
                  "pm.expect(json.fotoVerticalUrl).to.eql('https://cdn.vhl.test/paquetes/eje-cafetero-vertical.jpg');",
                  "pm.expect(json.fotoHorizontalUrl).to.eql('https://cdn.vhl.test/paquetes/eje-cafetero-horizontal.jpg');",
                  "pm.expect(json.incluye).to.include('Seguro de viaje');",
                  "pm.expect(json.noIncluye).to.include('Gastos personales');",
                  "pm.expect(json.politicasCancelacion).to.have.length(3);",
                  "pm.expect(json.itinerario).to.have.length(3);",
                  "pm.expect(json.itinerario.map(i => i.numeroDia)).to.eql([1, 2, 3]);",
                  "pm.expect(json.itinerario.every(i => !Object.prototype.hasOwnProperty.call(i, 'descripcion'))).to.eql(true);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Buscar paquetes con filtros",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/paquetes?destino=Quindio&activo=true&pagina=0&tamano=5&ordenarPor=titulo&direccion=asc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.content).to.be.an('array');",
                  "pm.expect(json.content.some(p => p.id === Number(pm.collectionVariables.get('paqueteId')))).to.eql(true);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Buscar paquete por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/paquetes/{{paqueteId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('paqueteId')));",
                  "pm.expect(json.idCategoria).to.eql(Number(pm.collectionVariables.get('categoriaId')));",
                  "pm.expect(json.fotoVerticalUrl).to.eql('https://cdn.vhl.test/paquetes/eje-cafetero-vertical.jpg');",
                  "pm.expect(json.fotoHorizontalUrl).to.eql('https://cdn.vhl.test/paquetes/eje-cafetero-horizontal.jpg');",
                  "pm.expect(json.itinerario.map(i => i.numeroDia)).to.eql([1, 2, 3]);",
                  "pm.expect(json.itinerario.every(i => !Object.prototype.hasOwnProperty.call(i, 'descripcion'))).to.eql(true);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Actualizar paquete",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Eje Cafetero Actualizado {{$timestamp}}\",\n  \"descripcion\": \"Paquete actualizado desde Postman con fotos e itinerario completo\",\n  \"destino\": \"Quindio\",\n  \"duracionDias\": 4,\n  \"precio\": 1450000.00,\n  \"cupo\": 15,\n  \"fechaInicio\": \"2026-07-10\",\n  \"fechaFin\": \"2026-07-14\",\n  \"lugarSalida\": \"Terminal del Norte\",\n  \"horaSalida\": \"07:00:00\",\n  \"alojamiento\": \"Hotel campestre 4 estrellas\",\n  \"tipoHabitacion\": \"Habitacion doble\",\n  \"tipoTransporte\": \"Avion\",\n  \"fotoVerticalUrl\": \"https://cdn.vhl.test/paquetes/eje-cafetero-vertical-v2.jpg\",\n  \"fotoHorizontalUrl\": \"https://cdn.vhl.test/paquetes/eje-cafetero-horizontal-v2.jpg\",\n  \"incluye\": [\n    \"Tiquetes aereos ida y regreso\",\n    \"Hospedaje en hotel campestre\",\n    \"Desayunos\",\n    \"Guia turistico\",\n    \"Seguro de viaje\"\n  ],\n  \"noIncluye\": [\n    \"Almuerzos no descritos\",\n    \"Gastos personales\"\n  ],\n  \"politicasCancelacion\": [\n    \"Cancelacion gratuita hasta 5 dias antes del viaje\",\n    \"50% de reembolso hasta 48 horas antes\",\n    \"No hay reembolso el mismo dia\"\n  ],\n  \"idCategoria\": {{categoriaId}},\n  \"itinerario\": [\n    {\n      \"numeroDia\": 1,\n      \"titulo\": \"Llegada\"\n    },\n    {\n      \"numeroDia\": 2,\n      \"titulo\": \"Tour cafetero premium\"\n    },\n    {\n      \"numeroDia\": 3,\n      \"titulo\": \"Salento y Valle del Cocora\"\n    },\n    {\n      \"numeroDia\": 4,\n      \"titulo\": \"Regreso\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/paquetes/{{paqueteId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('paqueteId')));",
                  "pm.expect(json.duracionDias).to.eql(4);",
                  "pm.expect(json.tipoTransporte).to.eql('Avion');",
                  "pm.expect(json.fotoVerticalUrl).to.eql('https://cdn.vhl.test/paquetes/eje-cafetero-vertical-v2.jpg');",
                  "pm.expect(json.fotoHorizontalUrl).to.eql('https://cdn.vhl.test/paquetes/eje-cafetero-horizontal-v2.jpg');",
                  "pm.expect(json.itinerario).to.have.length(4);",
                  "pm.expect(json.itinerario.map(i => i.numeroDia)).to.eql([1, 2, 3, 4]);",
                  "pm.expect(json.itinerario.every(i => !Object.prototype.hasOwnProperty.call(i, 'descripcion'))).to.eql(true);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Eliminar paquete",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/paquetes/{{paqueteId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 204', function () { pm.response.to.have.status(204); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
